{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.global.timezone": "Europe/Brussels",
  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.dashboard.content.card.fields.title": "title",
  "frontMatter.dashboard.content.card.fields.state": false,
  "frontMatter.dashboard.content.card.fields.description": "info",
  "frontMatter.content.hideFm": false,
  "frontMatter.content.hideFmMessage": "Use the editor panel to make front matter changes",
  "frontMatter.taxonomy.seoContentLength": -1,
  "frontMatter.taxonomy.seoDescriptionLength": -1,
  "frontMatter.taxonomy.seoTitleLength": -1,
  "frontMatter.extends": [
    "./themes/hugo-theme-relearn/vscode-frontmatter/snippets.en.json"
  ],
  "frontMatter.file.preserveCasing": true,
  "frontMatter.snippets.wrapper.enabled": false,
  "frontMatter.copilot.enabled": false,
  "frontMatter.file.slugSeparator": "_"
}
