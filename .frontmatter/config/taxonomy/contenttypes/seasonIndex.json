{
  "$schema": "https://frontmatter.codes/config/taxonomy.contenttypes.schema.json",
  "name": "seasonIndex",
  "pageBundle": false,
  "previewPath": null,
  "filePrefix": "",
  "fields": [
    {
      "title": "Weight",
      "name": "weight",
      "type": "number",
