{
  "$schema": "https://frontmatter.codes/config/taxonomy.contenttypes.schema.json",
  "name": "default",
  "pageBundle": false,
  "previewPath": null,
  "filePrefix": "",
  "fields": [
    {
      "title": "Weight",
      "name": "weight",
      "type": "number",
      "required": true,
      "numberOptions": {
        "min": 1,
        "max": 50,
        "step": 1
      }
    },
    {
      "title": "Poem title",
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "title": "ID",
      "name": "id",
      "type": "string",
      "description": "normalized title + _N",
      "required": true
    },
    {
      "title": "Writing date",
      "name": "date",
      "type": "datetime",
      "required": true,
      "dateFormat": "yyyy-MM-dd",
      "description": "Add year to TAGS"
    },
    {
      "title": "Metric",
      "name": "verseLength",
      "type": "number",
      "required": false,
      "numberOptions": {
        "min": -1,
        "max": 14,
        "step": 1
      },
      "description": "Add metric name(s) to TAGS. When variable: put -1 here, add 'métrique variable' to TAGS, and add 'Métrique variable : ' + comma-separated values in info."
    },
    {
      "name": "divider",
      "type": "divider"
    },
